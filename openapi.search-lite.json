{
  "openapi": "3.1.0",
  "info": {
    "title": "Materio MCP Search Lite",
    "description": "Slim OpenAPI spec for search clients. Tools: snap-search (primary), search (metadata fallback), share-link (masked PDF URLs).",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://mcp.getmaterio.app",
      "description": "Production server"
    }
  ],
  "paths": {
    "/api/snap-search": {
      "get": {
        "operationId": "SnapSearch",
        "summary": "PRIMARY tool: vectorless full-text search",
        "description": "PRIMARY retrieval endpoint for course Q&A. ALWAYS call this tool before drafting an answer. Do not answer from model knowledge without SnapSearch context. Fast keyword search over real text chunks with optional semester and subject filters.",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "minLength": 1 }
          },
          {
            "name": "semester",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "subject",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1 }
          },
          {
            "name": "results_per_page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "maximum": 20 },
            "description": "Preferred <= 5; max 20."
          },
          {
            "name": "max_words",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 100, "maximum": 500 }
          }
        ],
        "responses": {
          "200": {
            "description": "Vectorless search results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "query": { "type": "string" },
                    "semester": { "type": ["string", "null"] },
                    "subject": { "type": ["string", "null"] },
                    "page": { "type": "integer" },
                    "resultsPerPage": { "type": "integer" },
                    "maxWords": { "type": "integer" },
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "index": { "type": "integer" },
                          "topic": { "type": "string" },
                          "subject": { "type": "string" },
                          "similarity": { "type": "number" },
                          "excerpt": { "type": "string" }
                        }
                      }
                    },
                    "count": { "type": "integer" },
                    "hasMore": { "type": "boolean" },
                    "nextPage": { "type": ["integer", "null"] }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/search": {
      "get": {
        "operationId": "GlobalSearch",
        "summary": "Legacy metadata search (fallback)",
        "description": "Metadata-level search across subjects, section types, and topic names. Use only as fallback.",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "minLength": 2 }
          }
        ],
        "responses": {
          "200": {
            "description": "Search results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "query": { "type": "string" },
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "semester": { "type": "string" },
                          "subject": { "type": "string" },
                          "sectionType": { "type": "string" },
                          "topic": { "type": "string" },
                          "pdfUrl": { "type": "string", "format": "uri" }
                        }
                      }
                    },
                    "count": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

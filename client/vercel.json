{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://getmaterio.app https://www.getmaterio.app https://*.getmaterio.app https://beta.getmaterio.app https://materio.jinansh.workers.dev https://tauri.localhost http://tauri.localhost tauri://* tauri://localhost capacitor://* capacitor://localhost https://capacitor.localhost https://localhost https://localhost:* http://localhost:* http://127.0.0.1:* *"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/v2/login",
      "destination": "https://auth.getmaterio.app/api/v2/login"
    },
    {
      "source": "/api/v2/profile",
      "destination": "https://accounts.getmaterio.app/api/v2/profile"
    },
    {
      "source": "/share/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(googlebot|bingbot|yandex|baiduspider|duckduckbot|twitterbot|facebookexternalhit|linkedinbot|whatsapp|slackbot|discordbot|applebot|gptbot|chatgpt-user|anthropic-ai|claude-web|cohere-ai|bytespider|google-extended|perplex|yeti|bot|crawler|spider).*"
        }
      ],
      "destination": "https://mcp.getmaterio.app/share/:id"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}

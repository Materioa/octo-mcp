{
  "rewrites": [
    { "source": "/backend-api/(.*)", "destination": "/backend-api/index" },
    { "source": "/api/(.*)", "destination": "/backend-api/index" },
    { "source": "/mcp", "destination": "/backend-api/index" },
    { "source": "/mcp/(.*)", "destination": "/backend-api/index" },
    { "source": "/health", "destination": "/backend-api/index" },
    { "source": "/openapi.json", "destination": "/backend-api/index" },
    { "source": "/openapi.search-lite.json", "destination": "/backend-api/index" },
    { "source": "/(.*)", "destination": "/backend-api/index" }
  ],
  "functions": {
    "backend-api/**/*": {
      "includeFiles": "openapi*.json"
    }
  }
}
